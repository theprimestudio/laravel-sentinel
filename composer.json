{
    "name": "theprimestudio/laravel-sentinel",
    "description": "Enterprise security, antivirus, webshell detection, WAF, file integrity, and quarantine suite for Laravel",
    "type": "library",
    "license": "MIT",
    "homepage": "https://theprimestudio.com",
    "support": {
        "issues": "https://github.com/theprimestudio/laravel-sentinel/issues",
        "source": "https://github.com/theprimestudio/laravel-sentinel"
    },
    "authors": [
        {
            "name": "The Prime Studio",
            "email": "hello@theprimestudio.com",
            "homepage": "https://theprimestudio.com",
            "role": "Developer"
        }
    ],
    "keywords": [
        "laravel",
        "security",
        "antivirus",
        "malware-scanner",
        "webshell",
        "waf",
        "quarantine",
        "integrity",
        "clamav",
        "security-txt"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
        "illuminate/view": "^10.0 || ^11.0 || ^12.0",
        "illuminate/notifications": "^10.0 || ^11.0 || ^12.0",
        "symfony/process": "^6.0 || ^7.0",
        "ezyang/htmlpurifier": "^4.17 || ^4.18"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "spatie/laravel-permission": "Enables role and permission middleware on administrative security routes",
        "ext-fileinfo": "Provides accurate file MIME-type detection during scanning",
        "ext-curl": "Enables IP geolocation query capabilities"
    },
    "autoload": {
        "psr-4": {
            "ThePrimeStudio\\LaravelSentinel\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ThePrimeStudio\\LaravelSentinel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ThePrimeStudio\\LaravelSentinel\\SentinelServiceProvider"
            ],
            "aliases": {
                "Sentinel": "ThePrimeStudio\\LaravelSentinel\\Facades\\Sentinel",
                "Security": "ThePrimeStudio\\LaravelSentinel\\Facades\\Security"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
